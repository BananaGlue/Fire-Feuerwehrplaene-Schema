{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fireapp.io/p_brandmeldezentrale.schema.json",
  "title": "p_brandmeldezentrale",
  "description": "Enthält Daten zur Brandmeldezentrale.",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "FeatureCollection"
      ]
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BrandmeldezentralePointFeature"
      }
    }
  },
  "required": [
    "type",
    "features"
  ],
  "$defs": {
    "BrandmeldezentralePointFeature": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Feature"
          ]
        },
        "geometry": {
          "oneOf": [
            {
              "$ref": "GeoJSON.schema.json#/$defs/Point"
            }
          ]
        },
        "properties": {
          "type": "object",
          "properties": {
            "BEZ": {
              "description": "Bezeichnung",
              "type": "string",
              "enum": [
                "P100"
              ]
            },
            "FWPNR": {
              "description": "Feuerwehrplannummer",
              "$ref": "GeoJSON.schema.json#/$defs/TrimmedString"
            },
            "STN": {
              "description": "Stand",
              "type": "string",
              "format": "date"
            },
            "AKT": {
              "description": "Aktualisierung",
              "type": "string",
              "format": "date"
            },
            "AUF": {
              "description": "Aufgeschaltet",
              "type": "boolean"
            },
            "UGM": {
              "description": "UGM-Nummer",
              "type": "integer"
            },
            "PRIV": {
              "description": "Privat",
              "type": "boolean"
            },
            "ANM": {
              "description": "Anmerkung",
              "$ref": "GeoJSON.schema.json#/$defs/TrimmedString"
            }
          },
          "required": [
            "BEZ",
            "FWPNR",
            "STN",
            "AKT",
            "AUF",
            "UGM",
            "PRIV",
            "ANM"
          ]
        }
      },
      "required": [
        "type",
        "geometry",
        "properties"
      ]
    }
  }
}