{
  "$id": "https://fireapp.io/p_sonstigesymbole.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "p_sonstigesymbole",
  "description": "Bietet die Möglichkeit besondere Elemente, welche über die Liste nicht vordefiniert sind einzufügen und ist optional.",
  "$ref": "#/$defs/SonstigeSymbolePointFeatureCollection",
  "$defs": {
    "SonstigeSymbolePointFeatureCollection": {
      "allOf": [
        {
          "$ref": "Grunddatentypen.schema.json#/$defs/FeatureCollection"
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^(.+_)?p_sonstigesymbole$"
            },
            "features": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SonstigeSymbolePointFeature"
              }
            }
          },
          "required": [
            "features"
          ]
        }
      ]
    },
    "SonstigeSymbolePointBEZ": {
      "$ref": "Attributdatenfelder.schema.json#/$defs/BEZ",
      "pattern": "^P7\\d{2}$"
    },
    "SonstigeSymbolePointFeature": {
      "allOf": [
        {
          "$ref": "Grunddatentypen.schema.json#/$defs/PointFeature"
        },
        {
          "type": "object",
          "properties": {
            "properties": {
              "type": "object",
              "properties": {
                "BEZ": {
                  "$ref": "#/$defs/SonstigeSymbolePointBEZ"
                },
                "FWPNR": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/FWPNR"
                },
                "STN": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/STN"
                },
                "AKT": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/AKT"
                },
                "ANM": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/ANM"
                }
              },
              "required": [
                "BEZ",
                "FWPNR",
                "STN",
                "AKT",
                "ANM"
              ]
            }
          },
          "required": [
            "properties"
          ]
        }
      ]
    }
  }
}