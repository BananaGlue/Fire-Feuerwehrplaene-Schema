                "DN": {
                  "description": "Nenndurchmesser",
                  "type": "integer"
                },
                "ENT": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/ENT"
                },
                "OEF": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/OEF"
                },
                "GESCH": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/GESCH"
                },
                "EIN": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/EIN"
                },
                "ANM": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/ANM"
                }
              },
              "required": [
                "BEZ",
                "FWPNR",
                "STN",
                "AKT",
                "DN",
                "ENT",
                "OEF",
                "GESCH",
                "EIN",
                "ANM"
              ]
            }
          },
          "required": [
            "properties"
          ]
        }
      ]
    }
  }
}