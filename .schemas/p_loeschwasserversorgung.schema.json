{
  "$id": "p_loeschwasserversorgung.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "p_loeschwasserversorgung",
  "description": "Umfasst Daten zu möglichen Löschwasserversorgungseinrichtungen. Die Notwendigkeit zur Befüllung der einzelnen Fachattribute ist in Abhängigkeit zur jeweiligen Einrichtung zu wählen.",
  "$ref": "#/$defs/LoeschwasserversorgungPointFeatureCollection",
  "$defs": {
    "LoeschwasserversorgungPointFeatureCollection": {
      "allOf": [
        {
          "$ref": "Grunddatentypen.schema.json#/$defs/FeatureCollection"
        },
        {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "enum": [
                "p_loeschwasserversorgung"
              ]
            },
            "features": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/LoeschwasserversorgungPointFeature"
              }
            }
          },
          "required": [
            "title",
            "features"
          ]
        }
      ]
    },
    "LoeschwasserversorgungPointBEZ": {
      "$ref": "Attributdatenfelder.schema.json#/$defs/BEZ",
      "enum": [
        "P300",
        "P301",
        "P302",
        "P303",
        "P304",
        "P305",
        "P306",
        "P307",
        "P308",
        "P309",
        "P310",
        "P311",
        "P312",
        "P313",
        "P314",
        "P315",
        "P316",
        "P317"
      ]
    },
    "LoeschwasserversorgungPointFeature": {
      "allOf": [
        {
          "$ref": "Grunddatentypen.schema.json#/$defs/PolygonFeature"
        },
        {
          "type": "object",
          "properties": {
            "properties": {
              "type": "object",
              "properties": {
                "BEZ": {
                  "$ref": "#/$defs/LoeschwasserversorgungPointBEZ"
                },
                "FWPNR": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/FWPNR"
                },
                "STN": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/STN"
                },
                "AKT": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/AKT"
