{
  "$id": "l_feuerwehrzufahrten.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "l_feuerwehrzufahrten",
  "description": "Umfasst Elemente mit einer linienförmigen Ausprägung und wird in Kombination mit Elementen aus punktförmiger Darstellung verwendet. Hierbei können die geplanten Fahrwege z.B. zu Anleiterstellen auf dem Gelände dargestellt werden.",
  "$ref": "#/$defs/FeuerwehrzufahrtenLineFeatureCollection",
  "$defs": {
    "FeuerwehrzufahrtenLineFeatureCollection": {
      "allOf": [
        {
          "$ref": "Grunddatentypen.schema.json#/$defs/FeatureCollection"
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^(.+_)?l_feuerwehrzufahrten$"
            },
            "features": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/FeuerwehrzufahrtenLineFeature"
              }
            }
          },
          "required": [
            "features"
          ]
        }
      ]
    },
    "FeuerwehrzufahrtenLineBEZ": {
      "$ref": "Attributdatenfelder.schema.json#/$defs/BEZ",
      "enum": [
        "L200",
        "L201"
      ]
    },
    "FeuerwehrzufahrtenLineFeature": {
      "allOf": [
        {
          "$ref": "Grunddatentypen.schema.json#/$defs/LineFeature"
        },
        {
          "type": "object",
          "properties": {
            "properties": {
              "type": "object",
              "properties": {
                "BEZ": {
                  "$ref": "#/$defs/FeuerwehrzufahrtenLineBEZ"
                },
                "FWPNR": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/FWPNR"
                },
                "STN": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/STN"
                },
                "AKT": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/AKT"
                },
                "ANM": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/ANM"
                }
              },
              "required": [
                "BEZ",
                "FWPNR",
                "STN",
                "AKT",
                "ANM"
              ]
            }
          },
          "required": [
            "properties"
          ]
        }
      ]
    }
  }
}