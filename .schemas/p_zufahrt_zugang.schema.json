{
  "$id": "p_zufahrt_zugang.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "vfdb TB 07-01:2026-01",
  "title": "p_zufahrt_zugang",
  "description": "Umfasst Daten zu den Zufahrtsmöglichkeiten für die Feuerwehr, sowie mögliche Beschränkungen, welche diese unterliegen. Zusätzlich werden hier Daten über die Gebäudezugänge erfasst. Bei der Platzierung von Zufahrten und Zugängen ist die Rotationsausrichtung anzufügen (s. Attribut „DREH“), um eine korrekte Ausrichtung einer Pfeil-Symbolisierung zu gewährleisten. Bei Beschränkungen ist Rotationsausrichtung obsolet.",
  "$ref": "#/$defs/ZufahrtZugangFeatureCollection",
  "$defs": {
    "ZufahrtZugangFeatureCollection": {
      "allOf": [
        {
          "$ref": "Grunddatentypen.schema.json#/$defs/FeatureCollection"
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "title": "Ebenenname",
              "description": "Name der Ebene p_zufahrt_zugang, optional mit Präfix. QGIS schreibt hier den Dateinamen, z. B. 170174_p_zufahrt_zugang.",
              "type": "string",
              "pattern": "^(.+_)?p_zufahrt_zugang$"
            },
            "features": {
              "title": "Elemente der Ebene p_zufahrt_zugang",
              "description": "Umfasst Daten zu den Zufahrtsmöglichkeiten für die Feuerwehr, sowie mögliche Beschränkungen, welche diese unterliegen. Zusätzlich werden hier Daten über die Gebäudezugänge erfasst. Bei der Platzierung von Zufahrten und Zugängen ist die Rotationsausrichtung anzufügen (s. Attribut „DREH“), um eine korrekte Ausrichtung einer Pfeil-Symbolisierung zu gewährleisten. Bei Beschränkungen ist Rotationsausrichtung obsolet.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/ZufahrtZugangPointFeature"
              }
            }
          },
          "required": [
            "features"
          ]
        }
      ]
    },
    "ZufahrtZugangPointBEZ": {
      "$ref": "Attributdatenfelder.schema.json#/$defs/BEZ",
      "enum": [
        "P200",
        "P201",
        "P202",
        "P203",
        "P204",
        "P205",
        "P206"
      ],
      "enumDescriptions": [
        "Feuerwehr-Hauptzufahrt",
        "Feuerwehr-Nebenzufahrt",
        "Gebäudehaupteingang",
        "Gebäudenebeneingang",
        "max. Durchfahrtshöhe",
        "max. Durchfahrtsbreite",
        "max. zulässige Gesamtmasse"
      ]
    },
    "ZufahrtZugangPointFeature": {
      "allOf": [
        {
          "$ref": "Grunddatentypen.schema.json#/$defs/PointFeature"
        },
        {
          "type": "object",
          "properties": {
            "properties": {
              "title": "Attribute",
              "description": "Fachattribute des Elements. Alle Felder müssen vorhanden sein. Kann ein Fachattribut nicht gefüllt werden, ist es leer zu lassen (null), von Platzhaltern ist abzusehen.",
              "type": "object",
              "properties": {
                "BEZ": {
                  "$ref": "#/$defs/ZufahrtZugangPointBEZ"
                },
                "FWPNR": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/FWPNR"
                },
                "STN": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/STN"
                },
                "AKT": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/AKT"
                },
                "DREH": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/DREH"
                },
                "BESCH": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/BESCH"
                },
                "ANM": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/ANM"
                }
              },
              "required": [
                "BEZ",
                "FWPNR",
                "STN",
                "AKT",
                "DREH",
                "BESCH",
                "ANM"
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "BEZ": {
                        "enum": [
                          "P204",
                          "P205",
                          "P206"
                        ]
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "BESCH": {
                        "type": "number"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "BEZ": {
                        "enum": [
                          "P200",
                          "P201",
                          "P202",
                          "P203"
                        ]
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "DREH": {
                        "type": "number"
                      }
                    }
                  }
                }
              ]
            }
          },
          "required": [
            "properties"
          ]
        }
      ]
    }
  }
}