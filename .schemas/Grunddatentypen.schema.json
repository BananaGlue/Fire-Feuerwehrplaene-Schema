{
  "$id": "Grunddatentypen.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "vfdb TB 07-01:2026-01",
  "$defs": {
    "TrimmedString": {
      "type": "string",
      "pattern": "^\\S(.*\\S)?$"
    },
    "NullableTrimmedString": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\S(.*\\S)?$"
    },
    "NullableIntegerBoolean": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "NullableNonNegativeInteger": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "NullablePositiveInteger": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "NullablePLZInteger": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1000,
      "maximum": 99999
    },
    "NullablePositiveNumber": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "NullableDegreeNumber": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0.0,
      "maximum": 360.0
    },
    "Date": {
      "type": "string",
      "pattern": "^(?:(?:0[1-9]|1\\d|2[0-8])\\.(?:0[1-9]|1[0-2])|(?:29|30)\\.(?:0[13-9]|1[0-2])|31\\.(?:0[13578]|1[02]))\\.\\d{4}$|^29\\.02\\.(?:\\d{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)$",
      "patternErrorMessage": "Datum im Format TT.MM.JJJJ angeben, z. B. 01.04.2025."
    },
    "NullableDate": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(?:(?:0[1-9]|1\\d|2[0-8])\\.(?:0[1-9]|1[0-2])|(?:29|30)\\.(?:0[13-9]|1[0-2])|31\\.(?:0[13578]|1[02]))\\.\\d{4}$|^29\\.02\\.(?:\\d{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)$",
      "patternErrorMessage": "Datum im Format TT.MM.JJJJ angeben, z. B. 01.04.2025."
    },
    "FeatureCollection": {
      "type": "object",
      "properties": {
        "type": {
          "title": "Typ",
          "description": "GeoJSON-Objekttyp der Datei. Immer \"FeatureCollection\".",
          "type": "string",
          "enum": [
            "FeatureCollection"
          ]
        },
        "crs": {
          "title": "Koordinatenbezugssystem",
          "description": "Pflichtangabe. Legt fest, wie die Koordinaten der Datei zu lesen sind. Nach vfdb TB 07-01 sind die Daten in ETRS89 / UTM Zone 32 (EPSG:25832) bzw. Zone 33 (EPSG:25833) bereitzustellen.",
          "type": "object",
          "properties": {
            "type": {
              "title": "CRS-Typ",
              "description": "Art der CRS-Angabe. Immer \"name\".",
              "type": "string",
              "enum": [
                "name"
              ]
            },
            "properties": {
              "title": "CRS-Eigenschaften",
              "description": "Enthält den Namen des Koordinatenbezugssystems.",
              "type": "object",
              "properties": {
                "name": {
                  "title": "CRS-Name",
                  "description": "Kennung des Koordinatenbezugssystems. Die URN- und die Kurzform von EPSG:25832 und EPSG:25833 sind gleichwertig.",
                  "type": "string",
                  "enum": [
                    "urn:ogc:def:crs:OGC:1.3:CRS84",
                    "urn:ogc:def:crs:EPSG::25832",
                    "urn:ogc:def:crs:EPSG::25833",
                    "EPSG:25832",
                    "EPSG:25833"
                  ],
                  "enumDescriptions": [
                    "WGS 84, Länge/Breite in Dezimalgrad",
                    "ETRS89 / UTM Zone 32, Ost-/Nordwert in Metern",
                    "ETRS89 / UTM Zone 33, Ost-/Nordwert in Metern",
                    "ETRS89 / UTM Zone 32, Ost-/Nordwert in Metern (Kurzform)",
                    "ETRS89 / UTM Zone 33, Ost-/Nordwert in Metern (Kurzform)"
                  ]
                }
              },
              "required": [
                "name"
              ]
            }
          },
          "required": [
            "type",
            "properties"
          ]
        }
      },
      "required": [
        "type",
        "crs"
      ]
    },
    "PolygonFeature": {
      "type": "object",
      "properties": {
        "type": {
          "title": "Typ",
          "description": "GeoJSON-Objekttyp eines Elements. Immer \"Feature\".",
          "type": "string",
          "enum": [
            "Feature"
          ]
        },
        "geometry": {
          "$ref": "GeoJSON.schema.json#/$defs/Polygon"
        }
      },
      "required": [
        "type",
        "geometry"
      ]
    },
    "LineFeature": {
      "type": "object",
      "properties": {
        "type": {
          "title": "Typ",
          "description": "GeoJSON-Objekttyp eines Elements. Immer \"Feature\".",
          "type": "string",
          "enum": [
            "Feature"
          ]
        },
        "geometry": {
          "$ref": "GeoJSON.schema.json#/$defs/LineString"
        }
      },
      "required": [
        "type",
        "geometry"
      ]
    },
    "PointFeature": {
      "type": "object",
      "properties": {
        "type": {
          "title": "Typ",
          "description": "GeoJSON-Objekttyp eines Elements. Immer \"Feature\".",
          "type": "string",
          "enum": [
            "Feature"
          ]
        },
        "geometry": {
          "$ref": "GeoJSON.schema.json#/$defs/Point"
        }
      },
      "required": [
        "type",
        "geometry"
      ]
    }
  }
}