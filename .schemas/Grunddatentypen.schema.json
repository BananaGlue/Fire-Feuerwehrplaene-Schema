{
  "$id": "Grunddatentypen.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "TrimmedString": {
      "$ref": "#/$defs/NullableTrimmedString",
      "type": "string"
    },
    "NullableTrimmedString": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\S(.*\\S)?$"
    },
    "NullableIntegerBoolean": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "NullableNonNegativeInteger": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "NullablePLZInteger": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 10000,
      "maximum": 99999
    },
    "NullablePositiveNumber": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0.0
    },
    "NullableDegreeNumber": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0.0,
      "maximum": 360.0
    },
    "NullableDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "FeatureCollection": {
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "FeatureCollection"
          ]
        },
        "crs": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "name"
              ]
            },
            "properties": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "enum": [
                    "urn:ogc:def:crs:OGC:1.3:CRS84",
                    "urn:ogc:def:crs:EPSG::25832",
                    "urn:ogc:def:crs:EPSG::25833",
                    "EPSG:25832",
                    "EPSG:25833"
                  ]
                }
              },
              "required": [
                "name"
              ]
            }
          },
          "required": [
            "type",
            "properties"
          ]
        }
      },
      "required": [
        "type",
        "crs"
      ]
    },
    "PolygonFeature": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Feature"
          ]
        },
        "geometry": {
          "$ref": "GeoJSON.schema.json#/$defs/Polygon"
        }
      },
      "required": [
        "type",
        "geometry"
      ]
    },
    "LineFeature": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Feature"
          ]
        },
        "geometry": {
          "$ref": "GeoJSON.schema.json#/$defs/LineString"
        }
      },
      "required": [
        "type",
        "geometry"
      ]
    },
    "PointFeature": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Feature"
          ]
        },
        "geometry": {
          "$ref": "GeoJSON.schema.json#/$defs/Point"
        }
      },
      "required": [
        "type",
        "geometry"
      ]
    }
  }
}