{
  "$id": "Grunddatentypen.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "TrimmedString": {
      "type": "string",
      "pattern": "^\\S(.*\\S)?$"
    },
    "IntegerBoolean": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "PositiveInteger": {
      "type": "integer",
      "minimum": 0
    },
    "PLZInteger": {
      "type": "integer",
      "minimum": 10000,
      "maximum": 99999
    },
    "DegreeNumber": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 360.0
    },
    "FeatureCollection": {
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "FeatureCollection"
          ]
        },
        "crs": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "name"
              ]
            },
            "properties": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "enum": [
                    "urn:ogc:def:crs:OGC:1.3:CRS84"
                  ]
                }
              }
            }
          }
        }
      },
      "required": [
        "type"
      ]
    },
    "PolygonFeature": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Feature"
          ]
        },
        "geometry": {
          "$ref": "GeoJSON.schema.json#/$defs/Polygon"
        }
      },
      "required": [
        "type",
        "geometry"
      ]
    },
    "LineFeature": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Feature"
          ]
        },
        "geometry": {
          "$ref": "GeoJSON.schema.json#/$defs/LineString"
        }
      },
      "required": [
        "type",
        "geometry"
      ]
    },
    "PointFeature": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Feature"
          ]
        },
        "geometry": {
          "$ref": "GeoJSON.schema.json#/$defs/Point"
        }
      },
      "required": [
        "type",
        "geometry"
      ]
    }
  }
}