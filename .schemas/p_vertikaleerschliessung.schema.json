{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fireapp.io/p_vertikaleerschliessung.schema.json",
  "title": "p_vertikaleerschliessung",
  "description": "Dient der Darstellung von Elementen der vertikalen Erschließung eines Gebäudes.",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "FeatureCollection"
      ]
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/VertikaleErschliessungPointFeature"
      }
    }
  },
  "required": [
    "type",
    "features"
  ],
  "$defs": {
    "VertikaleErschliessungPointFeature": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Feature"
          ]
        },
        "geometry": {
          "oneOf": [
            {
              "$ref": "GeoJSON.schema.json#/$defs/Point"
            }
          ]
        },
        "properties": {
          "type": "object",
          "properties": {
            "BEZ": {
              "description": "Bezeichnung",
              "type": "string",
              "enum": [
                "P500",
                "P501",
                "P502",
                "P503",
                "P504",
                "P505",
                "P506",
                "P507"
              ]
            },
            "FWPNR": {
              "description": "Feuerwehrplannummer",
              "$ref": "GeoJSON.schema.json#/$defs/TrimmedString"
            },
            "STN": {
              "description": "Stand",
              "type": "string",
              "format": "date"
            },
            "AKT": {
              "description": "Aktualisierung",
              "type": "string",
              "format": "date"
            },
            "KEN": {
              "description": "Kennzeichnung",
              "$ref": "GeoJSON.schema.json#/$defs/TrimmedString"
            },
            "GESCHU": {
              "description": "unterstes Geschoss",
              "$ref": "GeoJSON.schema.json#/$defs/TrimmedString"
            },
            "GESCHO": {
              "description": "oberstes Geschoss",
              "$ref": "GeoJSON.schema.json#/$defs/TrimmedString"
            },
            "ANM": {
              "description": "Anmerkung",
              "$ref": "GeoJSON.schema.json#/$defs/TrimmedString"
            }
          },
          "required": [
            "BEZ",
            "FWPNR",
            "STN",
            "AKT",
            "KEN",
            "GESCHU",
            "GESCHO",
            "ANM"
          ]
        }
      },
      "required": [
        "type",
        "geometry",
        "properties"
      ]
    }
  }
}