{
  "$id": "p_vertikaleerschliessung.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "p_vertikaleerschliessung",
  "description": "Dient der Darstellung von Elementen der vertikalen Erschließung eines Gebäudes.",
  "$ref": "#/$defs/VertikaleErschliessungPointFeatureCollection",
  "$defs": {
    "VertikaleErschliessungPointFeatureCollection": {
      "allOf": [
        {
          "$ref": "Grunddatentypen.schema.json#/$defs/FeatureCollection"
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^(.+_)?p_vertikaleerschliessung$"
            },
            "features": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/VertikaleErschliessungPointFeature"
              }
            }
          },
          "required": [
            "features"
          ]
        }
      ]
    },
    "VertikaleErschliessungPointBEZ": {
      "$ref": "Attributdatenfelder.schema.json#/$defs/BEZ",
      "enum": [
        "P500",
        "P501",
        "P502",
        "P503",
        "P504",
        "P505",
        "P506",
        "P507"
      ]
    },
    "VertikaleErschliessungPointFeature": {
      "allOf": [
        {
          "$ref": "Grunddatentypen.schema.json#/$defs/PointFeature"
        },
        {
          "type": "object",
          "properties": {
            "properties": {
              "type": "object",
              "properties": {
                "BEZ": {
                  "$ref": "#/$defs/VertikaleErschliessungPointBEZ"
                },
                "FWPNR": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/FWPNR"
                },
                "STN": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/STN"
                },
                "AKT": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/AKT"
                },
                "KEN": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/KEN"
                },
                "GESCHU": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/GESCHU"
                },
                "GESCHO": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/GESCHO"
                },
                "ANM": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/ANM"
                }
              },
              "required": [
                "BEZ",
                "FWPNR",
                "STN",
                "AKT",
                "KEN",
                "GESCHU",
                "GESCHO",
                "ANM"
              ]
            }
          },
          "required": [
            "properties"
          ]
        }
      ]
    }
  }
}