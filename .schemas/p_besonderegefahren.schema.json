{
  "$id": "https://fireapp.io/tb-07-01/2026-01/p_besonderegefahren.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "p_besonderegefahren",
  "description": "Umfasst Hinweise auf besondere Gefahren. Über die Bezeichnung wird die Art der Gefahr definiert über das Attribut „GEF“ wird die Gefahrenquelle definiert. Detailangaben zu Menge, Sicherheitsabstand und Gefahrengruppe sind bei Bedarf in Abhängigkeit zum jeweiligen Element zu wählen.",
  "$ref": "#/$defs/BesondereGefahrenPointFeatureCollection",
  "$defs": {
    "BesondereGefahrenPointFeatureCollection": {
      "allOf": [
        {
          "$ref": "Grunddatentypen.schema.json#/$defs/FeatureCollection"
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^(.+_)?p_besonderegefahren$"
            },
            "features": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/BesondereGefahrenPointFeature"
              }
            }
          },
          "required": [
            "features"
          ]
        }
      ]
    },
    "BesondereGefahrenPointBEZ": {
      "$ref": "Attributdatenfelder.schema.json#/$defs/BEZ",
      "enum": [
        "P600",
        "P601",
        "P602",
        "P603",
        "P604",
        "P605",
        "P606",
        "P607",
        "P608",
        "P609",
        "P610",
        "P611",
        "P612",
        "P613",
        "P614",
        "P615",
        "P616",
        "P617"
      ],
      "enumDescriptions": [
        "Allgemeines Warnzeichen",
        "Warnung vor explosionsgefährlichen Stoffen",
        "Warnung vor radioaktiven Stoffen oder ionisierender Strahlung",
        "Warnung vor Laserstrahlen",
        "Warnung vor nicht ionisierender Strahlung",
        "Warnung vor magnetischem Feld",
        "Warnung vor Hindernissen am Boden",
        "Warnung vor Absturzgefahr",
        "Warnung vor Biogefährdung",
        "Warnung vor niedriger Temperatur/Frost",
        "Warnung vor Rutschgefahr",
        "Warnung vor elektrischer Spannung",
        "Warnung vor giftigen Stoffen",
        "Warnung vor feuergefährlichen Stoffen",
        "Warnung vor Gefahren durch das Aufladen von Batterien",
        "Warnung vor optischer Strahlung",
        "Warnung vor brandfördernden Stoffen",
        "Warnung vor Gasflaschen"
      ]
    },
    "BesondereGefahrenPointFeature": {
      "allOf": [
        {
          "$ref": "Grunddatentypen.schema.json#/$defs/PointFeature"
        },
        {
          "type": "object",
          "properties": {
            "properties": {
              "type": "object",
              "properties": {
                "BEZ": {
                  "$ref": "#/$defs/BesondereGefahrenPointBEZ"
                },
                "FWPNR": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/FWPNR"
                },
                "STN": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/STN"
                },
                "AKT": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/AKT"
                },
                "GEF": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/GEF"
                },
                "GESCH": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/GESCH"
                },
                "STO": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/STO"
                },
                "MENG": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/MENG"
                },
                "SAB": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/SAB"
                },
                "GFG": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/GFG"
                }
              },
              "required": [
                "BEZ",
                "FWPNR",
                "STN",
                "AKT",
                "GEF",
                "GESCH",
                "STO",
                "MENG",
                "SAB",
                "GFG"
              ]
            }
          },
          "required": [
            "properties"
          ]
        }
      ]
    }
  }
}