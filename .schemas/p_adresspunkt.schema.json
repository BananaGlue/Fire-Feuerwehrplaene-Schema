{
  "$id": "p_adresspunkt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "vfdb TB 07-01:2026-01",
  "title": "p_adresspunkt",
  "description": "Dient der Hinterlegung von Daten zu Adresse, Betreiber und Planersteller. Die Platzierung soll an der straßenzugewandten Seite der (Haupt-) Gebäudefläche erfolgen.",
  "$ref": "#/$defs/AdresspunktPointFeatureCollection",
  "$defs": {
    "AdresspunktPointFeatureCollection": {
      "allOf": [
        {
          "$ref": "Grunddatentypen.schema.json#/$defs/FeatureCollection"
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "title": "Ebenenname",
              "description": "Name der Ebene p_adresspunkt, optional mit Präfix. QGIS schreibt hier den Dateinamen, z. B. 170174_p_adresspunkt.",
              "type": "string",
              "pattern": "^(.+_)?p_adresspunkt$"
            },
            "features": {
              "title": "Elemente der Ebene p_adresspunkt",
              "description": "Dient der Hinterlegung von Daten zu Adresse, Betreiber und Planersteller. Die Platzierung soll an der straßenzugewandten Seite der (Haupt-) Gebäudefläche erfolgen.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/AdresspunktPointFeature"
              }
            }
          },
          "required": [
            "features"
          ]
        }
      ]
    },
    "AdresspunktPointBEZ": {
      "$ref": "Attributdatenfelder.schema.json#/$defs/BEZ",
      "enum": [
        "P000"
      ],
      "enumDescriptions": [
        "Adresspunkt"
      ]
    },
    "AdresspunktPointFeature": {
      "allOf": [
        {
          "$ref": "Grunddatentypen.schema.json#/$defs/PointFeature"
        },
        {
          "type": "object",
          "properties": {
            "properties": {
              "title": "Attribute",
              "description": "Fachattribute des Elements. Alle Felder müssen vorhanden sein. Kann ein Fachattribut nicht gefüllt werden, ist es leer zu lassen (null), von Platzhaltern ist abzusehen.",
              "type": "object",
              "properties": {
                "BEZ": {
                  "$ref": "#/$defs/AdresspunktPointBEZ"
                },
                "FWPNR": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/FWPNR"
                },
                "STN": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/STN"
                },
                "AKT": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/AKT"
                },
                "STRHNR": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/STRHNR"
                },
                "PLZ": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/PLZ"
                },
                "ORT": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/ORT"
                },
                "BTR": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/BTR"
                },
                "PLER": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/PLER"
                },
                "ANM": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/ANM"
                }
              },
              "required": [
                "BEZ",
                "FWPNR",
                "STN",
                "AKT",
                "STRHNR",
                "PLZ",
                "ORT",
                "BTR",
                "PLER",
                "ANM"
              ]
            }
          },
          "required": [
            "properties"
          ]
        }
      ]
    }
  }
}