              }
            }
          },
          "required": [
            "features"
          ]
        }
      ]
    },
    "VorbeugenderBaulicherBrandschutzPolygonBEZ": {
      "$ref": "Attributdatenfelder.schema.json#/$defs/BEZ",
      "enum": [
        "F100",
        "F101",
        "F102",
        "F103",
        "F104",
        "F105",
        "F106",
        "F107",
        "F108",
        "F109"
      ]
    },
    "VorbeugenderBaulicherBrandschutzPolygonFeature": {
      "allOf": [
        {
          "$ref": "Grunddatentypen.schema.json#/$defs/PolygonFeature"
        },
        {
          "type": "object",
          "properties": {
            "properties": {
              "type": "object",
              "properties": {
