                "FWPNR",
                "STN",
                "AKT",
                "GESCH",
                "FERT",
                "ANM"
              ],
              "if": {
                "properties": {
                  "BEZ": {
                    "enum": [
                      "F106"
                    ]
                  }
                }
              },
              "else": {
