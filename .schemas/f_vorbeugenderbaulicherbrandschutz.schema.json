      "allOf": [
        {
          "$ref": "Grunddatentypen.schema.json#/$defs/FeatureCollection"
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^(.+_)?f_vorbeugenderbaulicherbrandschutz$"
            },
            "features": {
              "type": "array",
              "items": {
