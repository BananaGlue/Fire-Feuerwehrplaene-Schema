{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fireapp.io/l_vorbeugenderbaulicherbrandschutz.schema.json",
  "title": "l_vorbeugenderbaulicherbrandschutz",
  "description": "Umfasst Elemente mit einer linienförmigen Ausprägung und wird z.T. in Kombination mit Elementen aus punktförmiger Darstellung verwendet.",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "FeatureCollection"
      ]
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/VorbeugenderBaulicherBrandschutzLineFeature"
      }
    }
  },
  "required": [
    "type",
    "features"
  ],
  "$defs": {
    "VorbeugenderBaulicherBrandschutzLineFeature": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Feature"
          ]
        },
        "geometry": {
          "oneOf": [
            {
              "$ref": "GeoJSON.schema.json#/$defs/LineString"
            }
          ]
        },
        "properties": {
          "type": "object",
          "properties": {
            "BEZ": {
              "description": "Bezeichnung",
              "type": "string",
              "enum": [
                "L100",
                "L101",
                "L102"
              ]
            },
            "FWPNR": {
              "description": "Feuerwehrplannummer",
              "$ref": "GeoJSON.schema.json#/$defs/TrimmedString"
            },
            "STN": {
              "description": "Stand",
              "type": "string",
              "format": "date"
            },
            "AKT": {
              "description": "Aktualisierung",
              "type": "string",
              "format": "date"
            },
            "GESCHU": {
              "description": "Straße HausNr.",
              "$ref": "GeoJSON.schema.json#/$defs/TrimmedString"
            },
            "GESCHO": {
              "description": "unterstes Geschoss",
              "$ref": "GeoJSON.schema.json#/$defs/TrimmedString"
            },
            "ORT": {
              "description": "oberstes Geschoss",
              "$ref": "GeoJSON.schema.json#/$defs/TrimmedString"
            },
            "ANM": {
              "description": "Anmerkung",
              "$ref": "GeoJSON.schema.json#/$defs/TrimmedString"
            }
          },
          "required": [
            "BEZ",
            "FWPNR",
            "STN",
            "AKT",
            "GESCHU",
            "GESCHO",
            "ANM"
          ]
        }
      },
      "required": [
        "type",
        "geometry",
        "properties"
      ]
    }
  }
}