{
  "$id": "l_vorbeugenderbaulicherbrandschutz.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "vfdb TB 07-01:2026-01",
  "title": "l_vorbeugenderbaulicherbrandschutz",
  "description": "Umfasst Elemente mit einer linienförmigen Ausprägung und wird z.T. in Kombination mit Elementen aus punktförmiger Darstellung verwendet.",
  "$ref": "#/$defs/VorbeugenderBaulicherBrandschutzLineFeatureCollection",
  "$defs": {
    "VorbeugenderBaulicherBrandschutzLineFeatureCollection": {
      "allOf": [
        {
          "$ref": "Grunddatentypen.schema.json#/$defs/FeatureCollection"
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "title": "Ebenenname",
              "description": "Name der Ebene l_vorbeugenderbaulicherbrandschutz, optional mit Präfix. QGIS schreibt hier den Dateinamen, z. B. 170174_l_vorbeugenderbaulicherbrandschutz.",
              "type": "string",
              "pattern": "^(.+_)?l_vorbeugenderbaulicherbrandschutz$"
            },
            "features": {
              "title": "Elemente der Ebene l_vorbeugenderbaulicherbrandschutz",
              "description": "Umfasst Elemente mit einer linienförmigen Ausprägung und wird z.T. in Kombination mit Elementen aus punktförmiger Darstellung verwendet.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/VorbeugenderBaulicherBrandschutzLineFeature"
              }
            }
          },
          "required": [
            "features"
          ]
        }
      ]
    },
    "VorbeugenderBaulicherBrandschutzLineBEZ": {
      "$ref": "Attributdatenfelder.schema.json#/$defs/BEZ",
      "enum": [
        "L100",
        "L101",
        "L102"
      ],
      "enumDescriptions": [
        "Brandwand",
        "Durchfahrt",
        "Zaunanlage"
      ]
    },
    "VorbeugenderBaulicherBrandschutzLineFeature": {
      "allOf": [
        {
          "$ref": "Grunddatentypen.schema.json#/$defs/LineFeature"
        },
        {
          "type": "object",
          "properties": {
            "properties": {
              "title": "Attribute",
              "description": "Fachattribute des Elements. Alle Felder müssen vorhanden sein. Kann ein Fachattribut nicht gefüllt werden, ist es leer zu lassen (null), von Platzhaltern ist abzusehen.",
              "type": "object",
              "properties": {
                "BEZ": {
                  "$ref": "#/$defs/VorbeugenderBaulicherBrandschutzLineBEZ"
                },
                "FWPNR": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/FWPNR"
                },
                "STN": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/STN"
                },
                "AKT": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/AKT"
                },
                "GESCHU": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/GESCHU"
                },
                "GESCHO": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/GESCHO"
                },
                "ANM": {
                  "$ref": "Attributdatenfelder.schema.json#/$defs/ANM"
                }
              },
              "required": [
                "BEZ",
                "FWPNR",
                "STN",
                "AKT",
                "GESCHU",
                "GESCHO",
                "ANM"
              ]
            }
          },
          "required": [
            "properties"
          ]
        }
      ]
    }
  }
}